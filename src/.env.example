# Copy this file to .env.local (for local dev) and fill in real values.
# .env.local is git-ignored and never committed.

# Base URL of the backend API (no trailing slash)
# Local dev example:  VITE_API_URL=http://localhost:8080
# Production example: VITE_API_URL=https://api.my-budget.example.com
VITE_API_URL=
